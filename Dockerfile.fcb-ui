# Bifrost FCB image WITH full React UI dashboard
# Combines: official UI build stage + FCB-patched Go binary build
# This fixes the missing /workspace/dashboard issue on the FCB validation build.

# --- UI Build Stage: Build the React + Vite frontend ---
FROM node:25-alpine3.23@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS ui-builder
WORKDIR /app
COPY ui/package*.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build-enterprise

# --- Go Build Stage: Compile FCB-patched Go binary WITH UI embedded ---
FROM golang:1.26.4-alpine3.23@sha256:f23e8b227fb4493eabe03bede4d5a32d04092da71962f1fb79b5f7d1e6c2a17f AS builder
WORKDIR /build

RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.tuna.tsinghua.edu.cn/alpine#g' /etc/apk/repositories && \
    apk add --no-cache gcc musl-dev sqlite-dev binutils binutils-gold

ENV CGO_ENABLED=1 GOOS=linux
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=1.6.0-fcb-ui

COPY core/ ./core/
COPY framework/ ./framework/
COPY plugins/ ./plugins/
COPY transports/ ./transports/

# Copy the REAL built UI from ui-builder stage (NOT a placeholder)
COPY --from=ui-builder /app/out ./transports/bifrost-http/ui

RUN go work init && \
    go work use ./core && \
    go work use ./framework && \
    go work use ./plugins/compat && \
    go work use ./plugins/governance && \
    go work use ./plugins/jsonparser && \
    go work use ./plugins/logging && \
    go work use ./plugins/maxim && \
    go work use ./plugins/mocker && \
    go work use ./plugins/otel && \
    go work use ./plugins/prompts && \
    go work use ./plugins/semanticcache && \
    go work use ./plugins/telemetry && \
    go work use ./transports

RUN cd /build/transports && \
    GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build \
      -ldflags="-w -s -X main.Version=v${VERSION} -extldflags '-static'" \
      -a -trimpath \
      -tags "sqlite_static" \
      -o /app/main \
      ./bifrost-http

RUN test -f /app/main

# --- Runtime Stage ---
FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11
WORKDIR /app
RUN sed -i 's#https://dl-cdn.alpinelinux.org/alpine#https://mirrors.tuna.tsinghua.edu.cn/alpine#g' /etc/apk/repositories && \
    apk add --no-cache musl libgcc ca-certificates zlib=1.3.2-r0
COPY --from=builder /app/main .
COPY transports/docker-entrypoint.sh .
ARG ARG_APP_PORT=8080
ARG ARG_APP_HOST=0.0.0.0
ARG ARG_LOG_LEVEL=info
ARG ARG_LOG_STYLE=json
ARG ARG_APP_DIR=/app/data
ENV APP_PORT=$ARG_APP_PORT \
    APP_HOST=$ARG_APP_HOST \
    LOG_LEVEL=$ARG_LOG_LEVEL \
    LOG_STYLE=$ARG_LOG_STYLE \
    APP_DIR=$ARG_APP_DIR \
    GOGC="" \
    GOMEMLIMIT=""
RUN mkdir -p "$APP_DIR/logs" && \
    adduser -D -s /bin/sh appuser && \
    chown -R appuser:appuser /app && \
    { [ "$APP_DIR" = "/app" ] || [ "${APP_DIR#/app/}" != "$APP_DIR" ] || chown -R appuser:appuser "$APP_DIR"; } && \
    chmod +x /app/docker-entrypoint.sh
USER appuser
VOLUME ["${APP_DIR}"]
EXPOSE $APP_PORT
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:${APP_PORT}/health || exit 1
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/main"]
